# 复制为 .env 填写。.env 不要提交（已在 .gitignore）。
# 1) 问答生成（DeepSeek，OpenAI 兼容接口）
LLM_BASE=https://api.deepseek.com
LLM_KEY=你的DeepSeekKey     # 问答与引用用；不填则只返回检索片段
LLM_MODEL=deepseek-chat

# 2) 向量索引（智谱 embedding-3）
EMB_BASE=https://open.bigmodel.cn/api/paas/v4
EMB_KEY=你的智谱Key
EMB_MODEL=embedding-3
EMB_BATCH=16
